# Non-secret settings only. Secrets are kept in the operating system's credential store.
#
# Copy to ".env" in the folder you run ops-suite from and uncomment what you need. Each line
# overrides the same key in config.toml; an empty value is ignored. Nested keys use "__".
# List values are written as JSON.
#
# OPS_SUITE_CONFIG (the config file location) is read from the real environment, not from .env.

# OPS_SUITE_PATHS__DATA_DIR=
# OPS_SUITE_PATHS__LOG_DIR=

# OPS_SUITE_MAIL__WORK__MAILBOX_ADDRESS=shared-mailbox@example.edu
# OPS_SUITE_MAIL__WORK__DROP_DIR=
# OPS_SUITE_MAIL__WORK__RETENTION_DAYS=7
# OPS_SUITE_MAIL__WORK__AUTOMATED_SENDERS=["notifications@tdx.example.edu", "@lists.example.edu"]
# OPS_SUITE_MAIL__WORK__AUTOMATED_LOCAL_PARTS=["no-reply", "noreply", "donotreply", "do-not-reply", "mailer-daemon", "postmaster"]

# OPS_SUITE_TDX__BASE_URL=https://tdx.example.edu/TDWorkManagement/
# OPS_SUITE_TDX__PROFILE_DIR=
# OPS_SUITE_TDX__DASHBOARD_URL=
# OPS_SUITE_TDX__DISPLAY_TIMEZONE=America/New_York
# OPS_SUITE_TDX__HEADLESS=true
# OPS_SUITE_TDX__MAX_PAGES_PER_WIDGET=20
# OPS_SUITE_TDX__PAGE_TIMEOUT_SECONDS=30
# OPS_SUITE_TDX__ALLOWED_REQUESTS=[]
# OPS_SUITE_TDX__WIDGETS__UNCLAIMED_TITLE=Unclaimed Tickets in My Group(s)
# OPS_SUITE_TDX__WIDGETS__CLAIMED_TITLE=Active Tickets Claimed by Others in My Group(s)
# OPS_SUITE_TDX__FEED_DELAY_SECONDS=2
# OPS_SUITE_TDX__MAX_FEEDS_PER_RUN=40
# OPS_SUITE_TDX__TICKET_URL_TEMPLATE=
# OPS_SUITE_TDX__RULES__STALE_HOURS=48
# OPS_SUITE_TDX__RULES__EVENT_OVER_HOURS=24
# OPS_SUITE_TDX__RULES__EVENT_TBD_DAYS=3
# Staff names are real people's names: set them only in your own config or .env, never commit them.
# OPS_SUITE_TDX__RULES__EXTRA_STAFF_NAMES=[]
# OPS_SUITE_TDX__RULES__DESK_MEMORY=true
# OPS_SUITE_TDX__RULES__DESK_MEMORY_FORGET_DAYS=180

# OPS_SUITE_TDX__ALERTS__REALERT_DAYS=3
# OPS_SUITE_TDX__ALERTS__OLD_FINDING_DAYS=30
# OPS_SUITE_TDX__ALERTS__OLD_REALERT_DAYS=7
# OPS_SUITE_TDX__ALERTS__TITLE_CHARS=80
# OPS_SUITE_TDX__ALERTS__MAX_ROWS_PER_CARD=25
# OPS_SUITE_TDX__WATCH__INTERVAL_MINUTES=30
# OPS_SUITE_TDX__WATCH__FAILURES_BEFORE_STOP=3
# OPS_SUITE_TDX__WATCH__SIGNED_OUT_RETRY_MINUTES=10

# The Teams webhook URLs are secrets: store them with "ops-suite teams set-webhook" (and
# "--to desk" for the desk chat), never here.
# OPS_SUITE_TEAMS__WEBHOOK_HOST_SUFFIXES=[".logic.azure.com", ".api.powerplatform.com"]
# OPS_SUITE_TEAMS__TIMEOUT_SECONDS=30
# OPS_SUITE_TEAMS__PERSONAL__SHOW_TITLES=true
# Desk chat (docs/USAGE.md, "Desk chat"): approved stays false until the desk approves real cards.
# OPS_SUITE_TEAMS__DESK__APPROVED=false
# OPS_SUITE_TEAMS__DESK__SHOW_TITLES=false

# The Anthropic API key is a secret: store it with "ops-suite llm set-key", never here.
# ALLOW_INSTITUTIONAL_DATA covers text from TDX tickets and the shared mailbox (it may include
# student records). Set it to true only on your own machine, and only once your institution has
# approved sending scrubbed ticket text to the API; never commit it as true. An unknown
# OPS_SUITE_LLM__ name stops the tool instead of being ignored.
# OPS_SUITE_LLM__ENABLED=false
# OPS_SUITE_LLM__ALLOW_INSTITUTIONAL_DATA=false
# OPS_SUITE_LLM__MODEL=claude-haiku-5-5
# OPS_SUITE_LLM__EFFORT=low
# OPS_SUITE_LLM__MAX_OUTPUT_TOKENS=256
# OPS_SUITE_LLM__MAX_INPUT_CHARS=2000
# OPS_SUITE_LLM__DAILY_TOKEN_BUDGET=100000
# OPS_SUITE_LLM__TIMEOUT_SECONDS=30
# OPS_SUITE_LLM__INPUT_USD_PER_MTOK=0.10
# OPS_SUITE_LLM__OUTPUT_USD_PER_MTOK=0.50
# OPS_SUITE_LLM__CACHE_READ_USD_PER_MTOK=0.01

# OPS_SUITE_SCHEDULE__TIMEZONE=America/New_York
# OPS_SUITE_SCHEDULE__DESK_HOURS={"mon": "07:30-22:00", "tue": "07:30-22:00", "wed": "07:30-22:00", "thu": "07:30-22:00", "fri": "07:30-22:00", "sat": "08:00-18:00", "sun": "12:00-17:00"}
